<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
    <ProjectReference Include="..\FarShell.ConPTY\FarShell.ConPTY.csproj" />
    <ProjectReference Include="..\FarShell.Protocol\FarShell.Protocol.csproj" />
    <ProjectReference Include="..\FarShell.Security\FarShell.Security.csproj" />
  </ItemGroup>

  <Target Name="KeepConPtyHostsOutsideBundle" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- ConPTY launches these native hosts from their architecture-specific directories. -->
      <None Update="@(None)" Condition="'%(None.Filename)%(None.Extension)' == 'OpenConsole.exe'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </None>
    </ItemGroup>
  </Target>

</Project>
